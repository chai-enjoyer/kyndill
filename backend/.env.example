PORT=3000

# PostgreSQL connection string (takes priority over individual DB_* vars below)
DATABASE_URL=postgresql://user:password@localhost:5432/kyndill

# Individual DB vars (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kyndill
DB_USER=kyndill_user
DB_PASSWORD=changeme

# Auth
JWT_SECRET=change_this_to_a_long_random_string
BCRYPT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=

# CORS
FRONTEND_URL=http://localhost:5173

# Node
NODE_ENV=development
